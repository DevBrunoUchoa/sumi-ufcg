NODE_ENV=development
PORT=3000
APP_PORT=3000
LOG_LEVEL=info
# Use false somente ao servir localmente por HTTP. Em produção HTTPS, deixe vazio.
SESSION_COOKIE_SECURE=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do SUMI (links de e-mail e volta do login com GOV.BR).
FRONTEND_URL=

# Login com GOV.BR (Login Único) — opcional; liga só com as três primeiras.
# Homologação: https://sso.staging.acesso.gov.br  Produção: https://sso.acesso.gov.br
# Local, sem credenciais: pnpm --filter backend govbr-simulado e
# GOVBR_ISSUER=http://127.0.0.1:4400, GOVBR_CLIENT_ID=sumi-local, GOVBR_CLIENT_SECRET=segredo-local.
GOVBR_ISSUER=
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# Precisa ser exatamente a URL de retorno cadastrada no GOV.BR.
# Padrão: FRONTEND_URL + /api/v1/auth/govbr/callback
GOVBR_REDIRECT_URI=

# Usadas somente por `pnpm --filter backend seed` (scripts/seed.ts) — nunca
# lidas pelo servidor em execução. Só SEED_ADMIN_* é obrigatória; as demais
# são opcionais (o seed pula os usuários que não tiverem e-mail/senha).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_GESTOR_EMAIL=
SEED_GESTOR_PASSWORD=
SEED_RESPONSAVEL_EMAIL=
SEED_RESPONSAVEL_PASSWORD=
