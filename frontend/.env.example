VITE_API_BASE_URL=
VITE_AUTH_SESSION_PATH=/api/v1/auth/session
VITE_PLANNING_WORKSPACE_PATH=/api/v1/planning/workspace
# "local": usa dados e contas fictícias do Vite (só em `pnpm dev`).
# "http": fala com a API real (backend/Supabase) em desenvolvimento.
# Builds de produção sempre usam HTTP, sem dados/contas locais no bundle.
VITE_DATA_SOURCE=
# Ativar apenas após implementar/configurar authorize e callback OIDC no backend.
# Nunca guardar client_secret ou outras credenciais do GOV.BR no frontend.
VITE_GOVBR_LOGIN_ENABLED=false
