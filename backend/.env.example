NODE_ENV=development
PORT=3000
APP_PORT=3000
LOG_LEVEL=info

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Usadas somente por `pnpm --filter backend seed` (scripts/seed.ts) — nunca
# lidas pelo servidor em execução. Só SEED_ADMIN_* é obrigatória; as demais
# são opcionais (o seed pula os usuários que não tiverem e-mail/senha).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_GESTOR_EMAIL=
SEED_GESTOR_PASSWORD=
SEED_RESPONSAVEL_EMAIL=
SEED_RESPONSAVEL_PASSWORD=
